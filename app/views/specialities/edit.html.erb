<div class="container page-min-height">
  <div class="row">
    <div class="col-md-8 offset-md-2">
      <h2 class="text-center my-5">Ma spécialité</h2>

      <div class="card card-body p-4">
        <p class="text-center mb-4">
          Avant d'accéder aux projets, indique-nous vers quelle spécialité tu souhaites t'orienter.
        </p>

        <%= simple_form_for @user, url: speciality_path, method: :patch do |f| %>
          <% @specialities.each do |speciality| %>
            <div class="form-check mb-3">
              <%= f.radio_button :speciality_id, speciality.id, class: "form-check-input", id: "speciality_#{speciality.slug}" %>
              <%= f.label :speciality_id, speciality.name, value: speciality.id, class: "form-check-label", for: "speciality_#{speciality.slug}" %>
            </div>
          <% end %>

          <%= f.button :submit, "Valider ma spécialité", class: "btn btn-danger text-white w-100 mt-3" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
