<div class="container page-min-height">
  <div class="row">
    <div class="col-lg-10 offset-lg-1">

      <div class="my-4">
        <%= link_to "← Retour à l'accueil", root_path, class: "text-decoration-none", style: "color: #66727F;" %>
      </div>

      <h2 class="text-center mb-4">Mes matières</h2>

      <% if @semestre.vide? %>
        <div class="agenda__vide">
          Aucun cours n'est rattaché à votre emploi du temps pour ce semestre.
          Si vous êtes enseignant, cette page présente le relevé personnel d'un
          étudiant : elle reste vide pour vous.
        </div>
      <% else %>

        <%= render "matieres/statut", semestre: @semestre, statut: @statut, evaluations: @evaluations %>
        <%= render "matieres/histogramme", semestre: @semestre %>

        <div class="soutien-annonce">
          <span class="soutien-annonce__pastille" aria-hidden="true">?</span>
          <div class="soutien-annonce__texte">
            <h4 class="soutien-annonce__titre">Besoin d'un coup de main ?</h4>
            <p>
              Des séances de soutien encadrées par des étudiants de L3 sont organisées.
              <% if @demandes.any? %>
                Vous êtes inscrit sur
                <strong><%= pluralize(@demandes.size, "matière") %></strong> :
                vous serez contacté pour les créneaux.
              <% else %>
                Signalez-vous sur les matières où vous en avez besoin, avec le bouton vert
                au bas de chaque matière.
              <% end %>
            </p>
          </div>
        </div>

        <h3 class="roadmap__sous-titre mt-5">Les matières du semestre</h3>
        <p class="matieres__regle">
          Le travail personnel attendu est d'autant d'heures que d'heures reçues en cours.
          Déclarez les vôtres dans la dernière colonne.
        </p>

        <% @semestre.matieres.each do |matiere| %>
          <% evaluation = @evaluations[matiere.ue.id] %>
          <% taux = matiere.taux_maison(evaluation) %>
          <section class="matiere">
            <span class="matiere__filet" style="background: <%= matiere.teinte %>;"></span>

            <div class="matiere__corps">
              <div class="matiere__entete">
                <h4 class="matiere__nom"><%= matiere.ue.name %></h4>
                <span class="matiere__heures">
                  <%= matiere.heures_faites %> h / <%= matiere.heures %> h
                  <span class="team-card__muted">· <%= matiere.nombre_seances %> séances</span>
                </span>
              </div>

              <div class="matiere__avancement">
                <div class="matiere__jauge">
                  <div class="matiere__jauge-barre"
                       style="width: <%= matiere.pourcentage %>%; background: <%= matiere.teinte %>;"></div>
                </div>
                <span class="matiere__pct"><%= matiere.pourcentage %> %</span>
              </div>

              <table class="autoeval">
                <thead>
                  <tr>
                    <th class="autoeval__quoi">Auto-évaluation</th>
                    <% UeAssessment::NIVEAUX.each do |cle, libelle| %>
                      <th class="autoeval__niveau" title="<%= UeAssessment::AIDES[cle] %>">
                        <%= libelle %>
                        <span class="autoeval__aide"><%= UeAssessment::AIDES[cle] %></span>
                      </th>
                    <% end %>
                    <th class="autoeval__niveau autoeval__maison">
                      Travail perso
                      <span class="autoeval__aide">attendu : <%= matiere.heures_faites %> h</span>
                    </th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <th class="autoeval__quoi">Niveau global sur la matière</th>
                    <% UeAssessment::NIVEAUX.each_key do |cle| %>
                      <td class="autoeval__case">
                        <%= form_with url: ue_assessment_path(matiere.ue), method: :patch,
                                       class: "autoeval__forme" do %>
                          <%= hidden_field_tag :level, cle %>
                          <button type="submit" class="autoeval__bouton <%= "autoeval__bouton--choisi" if evaluation&.level == cle %>"
                                  style="<%= "--teinte: #{matiere.teinte};" %>"
                                  title="<%= UeAssessment::NIVEAUX[cle] %>"
                                  aria-label="<%= UeAssessment::NIVEAUX[cle] %>"></button>
                        <% end %>
                      </td>
                    <% end %>
                    <td class="autoeval__case autoeval__maison">
                      <%= form_with url: ue_assessment_path(matiere.ue), method: :patch,
                                     class: "maison__forme" do %>
                        <%= number_field_tag :home_hours, evaluation&.home_hours.to_f.round(1),
                              min: 0, step: 0.5, class: "maison__champ",
                              onchange: "this.form.requestSubmit()", "aria-label": "Heures de travail personnel" %>
                        <span class="maison__unite">h</span>
                      <% end %>
                      <% if taux %>
                        <span class="maison__taux <%= "maison__taux--faible" if taux < 60 %>"><%= taux %> %</span>
                      <% end %>
                    </td>
                  </tr>
                </tbody>
              </table>

              <div class="matiere__pied">
                <% if evaluation&.level %>
                  <span class="matiere__niveau">Niveau déclaré : <strong><%= evaluation.libelle %></strong></span>
                  <%= form_with url: ue_assessment_path(matiere.ue), method: :patch,
                                 class: "autoeval__forme" do %>
                    <%= hidden_field_tag :level, "" %>
                    <%= submit_tag "Effacer", class: "no-btn matiere__effacer" %>
                  <% end %>
                <% else %>
                  <span class="matiere__niveau text-grey">Pas encore évaluée.</span>
                <% end %>
              </div>

              <% demande = @demandes.include?(matiere.ue.id) %>
              <div class="soutien-choix <%= "soutien-choix--prise" if demande %>">
                <%= form_with url: ue_tutoring_request_path(matiere.ue), method: :post,
                               class: "soutien-choix__forme" do %>
                  <button type="submit" class="soutien-btn <%= "soutien-btn--prise" if demande %>">
                    <% if demande %>
                      <span class="soutien-btn__coche" aria-hidden="true">✓</span>
                      <span>Inscrit au soutien</span>
                      <span class="soutien-btn__retrait">me retirer</span>
                    <% else %>
                      <span class="soutien-btn__libelle">Je souhaite du soutien</span>
                      <span class="soutien-btn__matiere"><%= matiere.ue.name %></span>
                    <% end %>
                  </button>
                <% end %>
                <span class="soutien-choix__aide">
                  <% if demande %>
                    Votre demande est enregistrée. Vous serez contacté pour les créneaux.
                  <% else %>
                    Séances encadrées par des étudiants de L3.
                    Seuls les enseignants voient votre demande, jamais les autres étudiants.
                  <% end %>
                </span>
              </div>

              <p class="matiere__a-venir">
                Les connaissances travaillées dans cette matière seront listées ici,
                avec la même échelle, dès que le référentiel sera disponible.
              </p>
            </div>
          </section>
        <% end %>

      <% end %>
    </div>
  </div>
</div>
