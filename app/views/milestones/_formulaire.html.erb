<%= simple_form_for [team, milestone], html: { class: "jalon-forme", data: { turbo: false } } do |f| %>
  <div class="jalon-forme__ligne">
    <%= f.input :name, label: "Intitulé de l'étape", input_html: { placeholder: "Prototype fonctionnel" }, wrapper_html: { class: "jalon-forme__large" } %>
    <%= f.input :starts_on, as: :date, html5: true, label: "Début" %>
    <%= f.input :due_on, as: :date, html5: true, label: "Échéance" %>
  </div>
  <%= f.input :description, as: :text, label: "Objectif",
              input_html: { rows: 2, placeholder: "Ce qui doit être atteint à cette étape." } %>
  <div class="jalon-forme__actions">
    <%= f.submit bouton, class: "btn btn-danger" %>
    <% if milestone.persisted? %>
      <%= button_to "Supprimer ce jalon", team_milestone_path(team, milestone), method: :delete,
                    form: { data: { turbo: false, turbo_confirm: "Supprimer ce jalon ? Ses tâches resteront au tableau, sans rattachement." } },
                    class: "btn btn-supp" %>
    <% end %>
  </div>
<% end %>
