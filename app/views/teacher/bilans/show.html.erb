<div class="container-fluid page-min-height">
  <div class="row">
    <div class="col-12 col-xxl-11 offset-xxl-1">

      <div class="section-head" style="margin-bottom: 1.2rem;">
        <h2>Bilan de présences</h2>
        <p>Un onglet par matière. Les appels déjà faits sont repris ; tout reste modifiable.</p>
      </div>

      <% if current_user.admin && @enseignants.present? %>
        <%# L'administrateur consulte le relevé de n'importe quel intervenant :
            c'est ainsi qu'il dépanne celui qui n'y arrive pas. %>
        <div class="bilan__consulte">
          <span class="bilan__consulte-libelle">Relevé de</span>
          <%= form_with url: teacher_bilan_path, method: :get, class: "bilan__consulte-forme" do %>
            <%= select_tag :teacher_id,
                  options_from_collection_for_select(@enseignants, :id,
                    ->(u) { "#{u.last_name.to_s.upcase} #{u.first_name}" }, @enseignant.id),
                  class: "form-select form-select-sm",
                  onchange: "this.form.requestSubmit()" %>
          <% end %>
          <% if @enseignant != current_user %>
            <span class="bilan__consulte-alerte">
              Vous consultez le relevé d'un collègue — vos modifications s'y inscrivent.
            </span>
            <%= link_to "Revenir au mien", teacher_bilan_path, class: "btn btn-sm btn-outline-ink" %>
          <% end %>
        </div>
      <% end %>

      <% if @ues.empty? %>
        <div class="agenda__vide">
          <% if @enseignant && @enseignant != current_user %>
            Aucune séance n'est rattachée à ce compte dans l'emploi du temps.
          <% else %>
            Aucune séance ne vous est rattachée dans l'emploi du temps. Les bilans
            apparaîtront dès qu'un cours vous sera associé.
          <% end %>
        </div>
      <% else %>
        <ul class="bilan__onglets">
          <% @ues.each do |ue| %>
            <li>
              <%= link_to ue.name, teacher_bilan_path(ue_id: ue.id, teacher_id: (@enseignant.id if @enseignant != current_user)),
                          class: "bilan__onglet #{'bilan__onglet--actif' if ue == @ue}" %>
            </li>
          <% end %>
        </ul>

        <% if @sheet.nil? || @sheet.vide? %>
          <div class="agenda__vide">Aucune séance passée pour cette matière.</div>
        <% else %>
          <div class="bilan__barre">
            <span class="bilan__compte">
              <%= @sheet.lessons.size %> séance<%= "s" if @sheet.lessons.size > 1 %> ·
              <%= @sheet.eleves.size %> étudiants
            </span>
            <%= link_to "Exporter la grille", export_teacher_bilan_path(ue_id: @ue.id, teacher_id: (@enseignant.id if @enseignant != current_user)),
                        class: "btn btn-outline-ink btn-sm" %>
            <%= form_with url: import_teacher_bilan_path, method: :post, multipart: true,
                          data: { turbo: false }, class: "bilan__import" do %>
              <%= hidden_field_tag :ue_id, @ue.id %>
              <%= file_field_tag :fichier, accept: ".xlsx,.xls,.csv", class: "form-control form-control-sm" %>
              <%= submit_tag "Importer", class: "btn btn-outline-ink btn-sm" %>
            <% end %>
          </div>
          <p class="bilan__aide">
            Exportez la grille, remplissez-la dans Excel, réimportez-la : les colonnes
            sont reconnues par leur en-tête. « P », « Absent justifié », « AJ », « R »
            sont compris indifféremment.
          </p>

          <%= form_with url: teacher_bilan_path, method: :patch,
                         data: { turbo: false, controller: "bilan",
                                 bilan_url_value: teacher_bilan_path,
                                 bilan_ue_value: @ue.id,
                                 bilan_enseignant_value: @enseignant.id } do %>
            <%= hidden_field_tag :ue_id, @ue.id %>
            <div class="bilan__cadre">
              <table class="bilan">
                <thead>
                  <tr>
                    <th class="bilan__eleve">Étudiant</th>
                    <% @sheet.lessons.each do |l| %>
                      <th class="bilan__seance <%= "bilan__seance--future" if @sheet.future?(l) %>"
                          <%= "title=\"Séance à venir — vous pouvez déjà y porter une absence justifiée\"".html_safe if @sheet.future?(l) %>>
                        <span class="bilan__date"><%= @sheet.entete(l) %></span>
                        <span class="bilan__sous">
                          <%= @sheet.sous_entete(l) %>
                          <span class="bilan__attendus"><%= @sheet.nombre_attendus(l) %></span>
                        </span>
                      </th>
                    <% end %>
                  </tr>
                </thead>
                <tbody>
                  <% @sheet.eleves.each do |eleve| %>
                    <tr>
                      <th class="bilan__eleve">
                        <%= eleve.last_name %> <span class="team-card__muted"><%= eleve.first_name %></span>
                      </th>
                      <% @sheet.lessons.each do |l| %>
                        <% statut = @sheet.statut(l, eleve) %>
                        <% attendu = @sheet.attendu?(l, eleve) %>
                        <td class="bilan__case bilan__case--<%= statut || 'vide' %> <%= "bilan__case--hors" unless attendu %>"
                            <%= "title=Étudiant\ d'un\ autre\ groupe".html_safe unless attendu %>>
                          <%= select_tag "statuts[#{l.id}][#{eleve.id}]",
                                options_for_select(Attendance::LIBELLES.map { |k, v| [v, k] }, statut),
                                include_blank: "—", class: "bilan__select",
                                data: { action: "change->bilan#enregistrer" } %>
                        </td>
                      <% end %>
                    </tr>
                  <% end %>

                  <% @sheet.invites.each_with_index do |invite, i| %>
                    <tr class="bilan__ligne-invite">
                      <th class="bilan__eleve">
                        <%= invite.libelle %>
                        <span class="team-card__muted">
                          ajouté à la main<%= " · #{invite.numero}" if invite.numero.present? %>
                        </span>
                        <%= hidden_field_tag "invites[#{i}][nom]", invite.nom, id: nil %>
                        <%= hidden_field_tag "invites[#{i}][prenom]", invite.prenom, id: nil %>
                        <%= hidden_field_tag "invites[#{i}][numero]", invite.numero, id: nil %>
                      </th>
                      <% @sheet.lessons.each do |l| %>
                        <% statut = invite.statut(l.id) %>
                        <td class="bilan__case bilan__case--<%= statut || 'vide' %>">
                          <%= select_tag "invites[#{i}][statuts][#{l.id}]",
                                options_for_select(Attendance::LIBELLES.map { |k, v| [v, k] }, statut),
                                include_blank: "—", class: "bilan__select", id: nil,
                                data: { action: "change->bilan#enregistrer" } %>
                        </td>
                      <% end %>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>

            <div class="bilan__pied">
              <%# Sans JavaScript, le bouton reste la seule façon d'enregistrer.
                  Avec, chaque case part seule et le bouton s'efface. %>
              <%= submit_tag "Enregistrer la grille", class: "btn btn-danger",
                    data: { bilan_target: "bouton" } %>
              <span class="bilan__etat" data-bilan-target="etat" hidden>
                Chaque modification est enregistrée aussitôt.
              </span>
            </div>
          <% end %>

          <% reste = @sheet.reste_de_la_promo %>
          <% if reste.any? %>
            <div class="card card-body p-4 mt-4">
              <a class="appel__replier" data-bs-toggle="collapse" href="#ajoutPromo" role="button"
                 aria-expanded="false" aria-controls="ajoutPromo">
                Ajouter un étudiant de la promotion
              </a>
              <p class="text-grey mt-2 mb-0"><small>
                Pour quelqu'un qui n'était pas prévu dans ce TD ou ce TP mais que
                vous avez en cours. Il prend une ligne dans la grille.
              </small></p>

              <div class="collapse mt-3" id="ajoutPromo">
                <div data-controller="filtre">
                  <%= search_field_tag :recherche_promo, nil,
                        placeholder: "Rechercher un nom ou un numéro…",
                        autocomplete: "off", class: "form-control appel__recherche",
                        data: { filtre_target: "champ", action: "input->filtre#filtrer" } %>

                  <ul class="appel__liste appel__liste--compacte">
                    <% reste.each do |eleve| %>
                      <li class="appel__ligne" data-filtre-target="ligne"
                          data-recherche="<%= "#{eleve.first_name} #{eleve.last_name} #{eleve.student_number}" %>">
                        <span class="appel__nom">
                          <%= eleve.first_name %> <%= eleve.last_name %>
                          <span class="appel__num"><%= eleve.student_number %></span>
                        </span>
                        <span class="appel__portee">
                          <%= button_to "Toute la matière",
                                        eleve_teacher_bilan_path(ue_id: @ue.id, user_id: eleve.id, portee: "matiere"),
                                        form: { data: { turbo: false } }, class: "btn btn-sm btn-portee",
                                        title: "Attendu à chaque séance et proposé à l'appel" %>
                          <%= button_to "Ce relevé",
                                        eleve_teacher_bilan_path(ue_id: @ue.id, user_id: eleve.id, portee: "releve"),
                                        form: { data: { turbo: false } }, class: "btn btn-sm btn-outline-ink",
                                        title: "Une ligne dans ce tableau, sans figurer aux appels" %>
                        </span>
                      </li>
                    <% end %>
                  </ul>
                  <p class="text-grey mt-2 mb-0" data-filtre-target="vide" hidden>
                    <small>Aucun étudiant ne correspond à cette recherche.</small>
                  </p>
                </div>
              </div>
            </div>
          <% end %>

          <div class="card card-body p-4 mt-4">
            <a class="appel__replier" data-bs-toggle="collapse" href="#ajoutEleve" role="button"
               aria-expanded="false" aria-controls="ajoutEleve">
              Ajouter un étudiant absent de la promotion
            </a>
            <p class="text-grey mt-2 mb-0"><small>
              Pour un nouvel inscrit, un auditeur, ou quelqu'un que la scolarité
              n'a pas encore rattaché à cette matière. Il apparaîtra en bas de la
              grille et vous pourrez renseigner ses séances comme les autres.
            </small></p>

            <div class="collapse mt-3 <%= "show" if flash.now[:alert] %>" id="ajoutEleve">
              <%= form_with url: eleve_teacher_bilan_path, method: :post,
                             class: "appel__saisie", data: { turbo: false } do %>
                <%= hidden_field_tag :ue_id, @ue.id %>
                <%= text_field_tag :guest_first_name, nil, placeholder: "Prénom", class: "form-control" %>
                <%= text_field_tag :guest_last_name, nil, placeholder: "Nom", class: "form-control" %>
                <%= text_field_tag :guest_student_number, nil, placeholder: "Numéro étudiant", class: "form-control" %>

                <fieldset class="portee">
                  <legend class="portee__titre">Faut-il l'attendre aux prochaines séances ?</legend>
                  <label class="portee__choix">
                    <%= radio_button_tag :portee, "matiere", true %>
                    <span><strong>Oui, à chaque séance de <%= @ue.name %></strong><br>
                      <small>Il figurera sur les feuilles d'appel, comme les autres.</small></span>
                  </label>
                  <label class="portee__choix">
                    <%= radio_button_tag :portee, "releve", false %>
                    <span><strong>Non, seulement dans ce tableau</strong><br>
                      <small>Pour quelqu'un venu une fois : vous renseignez ses cases ici,
                        il n'apparaît sur aucune feuille d'appel.</small></span>
                  </label>
                </fieldset>

                <%= submit_tag "Ajouter", class: "btn btn-danger" %>
              <% end %>
              <p class="text-grey mt-2 mb-0"><small>
                Aucun champ n'est obligatoire ni vérifié : saisissez ce dont vous disposez.
              </small></p>
            </div>
          </div>
        <% end %>
      <% end %>

    </div>
  </div>
</div>
