<li class="appel__ligne <%= "appel__ligne--present" if pointage&.statut_present? %>">
  <span class="appel__nom">
    <%= nom %>
    <% if numero.present? %><span class="appel__num"><%= numero %></span><% end %>
    <% if pointage&.statut_present? && pointage.by_student? %>
      <span class="appel__source">signalé par l'étudiant à <%= pointage.declared_at&.strftime("%H:%M") %></span>
    <% elsif pointage&.statut_present? %>
      <span class="appel__source">pointé par l'enseignant</span>
    <% end %>
  </span>
  <span class="appel__boutons">
    <% if eleve %>
      <%= button_to "Présent", teacher_lesson_attendance_path(lesson, eleve, status: :present),
                    method: :patch, form: { data: { turbo: false } },
                    class: "btn btn-sm #{pointage&.statut_present? ? 'btn-danger' : 'btn-outline-ink'}",
                    disabled: lesson.valide? %>
      <%= button_to "Absent", teacher_lesson_attendance_path(lesson, eleve, status: :absent),
                    method: :patch, form: { data: { turbo: false } },
                    class: "btn btn-sm #{pointage && pointage.statut_absent? ? 'btn-supp' : 'btn-outline-ink'}",
                    disabled: lesson.valide? %>
    <% else %>
      <span class="appel__etiquette">saisie manuelle</span>
      <%= button_to "Retirer", teacher_lesson_attendance_path(lesson, pointage),
                    method: :delete, form: { data: { turbo: false, turbo_confirm: "Retirer cette ligne ?" } },
                    class: "btn btn-sm btn-supp", disabled: lesson.valide? %>
    <% end %>
  </span>
</li>
