<div class="container page-min-height">
  <div class="row">
    <div class="col-lg-10 offset-lg-1">

      <div class="my-4">
        <%= link_to "← Retour à l'accueil", root_path, class: "text-decoration-none", style: "color: #66727F;" %>
      </div>

      <h2 class="text-center mb-1">Soutien tutoré — récapitulatif</h2>
      <p class="matieres__regle text-center">
        <%= @batch.title %> · combien d'étudiants se sont signalés, matière par matière.
        <span class="recap__prive">Page réservée à l'administration</span>
      </p>

      <% if @batches.size > 1 %>
        <div class="d-flex justify-content-center flex-wrap my-4" style="gap: .5rem;">
          <% @batches.each do |batch| %>
            <%= link_to batch.title, recap_teacher_soutien_path(batch_id: batch.id),
                        class: "btn btn-sm #{batch == @batch ? 'btn-danger' : 'btn-outline-ink'}" %>
          <% end %>
        </div>
      <% end %>

      <% if @soutien.vide? %>
        <div class="agenda__vide">
          Aucune demande pour le moment sur <%= @batch.title %>.
          Les étudiants s'inscrivent depuis « Mes matières ».
        </div>
      <% else %>

        <div class="soutien__chiffres">
          <div class="soutien__chiffre">
            <span class="soutien__valeur"><%= @soutien.demandeurs %></span>
            <span class="soutien__label">étudiant<%= "s" if @soutien.demandeurs > 1 %> concerné<%= "s" if @soutien.demandeurs > 1 %></span>
          </div>
          <div class="soutien__chiffre">
            <span class="soutien__valeur"><%= @soutien.total %></span>
            <span class="soutien__label">inscription<%= "s" if @soutien.total > 1 %> au total</span>
          </div>
          <div class="soutien__chiffre">
            <span class="soutien__valeur"><%= @soutien.sollicitees %></span>
            <span class="soutien__label">matière<%= "s" if @soutien.sollicitees > 1 %> demandée<%= "s" if @soutien.sollicitees > 1 %></span>
          </div>
          <div class="soutien__chiffre">
            <span class="soutien__valeur"><%= (@soutien.total.to_f / @soutien.demandeurs).round(1) %></span>
            <span class="soutien__label">matières par étudiant, en moyenne</span>
          </div>
        </div>

        <h3 class="roadmap__sous-titre">La demande par matière</h3>
        <p class="matieres__regle">
          La barre donne la part des étudiants qui suivent la matière. Dix demandes
          sur une option de quinze ne disent pas la même chose que dix sur un tronc
          commun de quatre-vingts.
        </p>

        <% maxi = @soutien.lignes.map(&:nombre).max %>
        <div class="enrobage-table">
          <table class="recap__table">
            <thead>
              <tr>
                <th>Matière</th>
                <th class="recap__nombre">Demandes</th>
                <th class="recap__nombre">Inscrits</th>
                <th class="recap__nombre">Part</th>
                <th style="min-width: 10rem;">Volume</th>
                <th class="recap__nombre" title="Se déclarent à « notion » ou « initiation »">En difficulté</th>
              </tr>
            </thead>
            <tbody>
              <% @soutien.lignes.each do |ligne| %>
                <tr class="<%= "recap__ligne--muette" if ligne.nombre.zero? %>">
                  <td>
                    <span class="recap__teinte" style="background: <%= ligne.ue.teinte %>;"></span>
                    <% if ligne.ue.code.present? %><span class="recap__code"><%= ligne.ue.code %></span><% end %>
                    <%= ligne.ue.name %>
                  </td>
                  <td class="recap__nombre"><strong><%= ligne.nombre %></strong></td>
                  <td class="recap__nombre"><%= ligne.suivi.positive? ? ligne.suivi : "—" %></td>
                  <td class="recap__nombre"><%= ligne.taux ? "#{ligne.taux} %" : "—" %></td>
                  <td>
                    <% if ligne.nombre.positive? %>
                      <div class="recap__barre">
                        <div class="recap__barre-part"
                             style="width: <%= (100.0 * ligne.nombre / maxi).round %>%; background: <%= ligne.ue.teinte %>;"></div>
                      </div>
                    <% end %>
                  </td>
                  <td class="recap__nombre">
                    <% if ligne.fragiles.positive? %>
                      <span class="soutien__alerte"><%= ligne.fragiles %></span>
                    <% else %>
                      —
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <h3 class="roadmap__sous-titre mt-5">Le niveau que les demandeurs se donnent</h3>
        <p class="matieres__regle">
          Sur les <%= @soutien.total %> inscriptions. Un gros volume de « notion »
          n'appelle pas le même dispositif qu'un gros volume d'« application ».
        </p>
        <div class="recap__niveaux">
          <% niveaux = @soutien.par_niveau %>
          <% [[nil, "Non déclaré"], *UeAssessment::NIVEAUX.to_a].each do |cle, libelle| %>
            <% n = niveaux[cle].to_i %>
            <div class="recap__niveau">
              <span class="recap__niveau-nombre"><%= n %></span>
              <span class="recap__niveau-libelle"><%= libelle %></span>
              <div class="recap__barre">
                <div class="recap__barre-part recap__barre-part--<%= cle || 'inconnu' %>"
                     style="width: <%= @soutien.total.zero? ? 0 : (100.0 * n / @soutien.total).round %>%;"></div>
              </div>
            </div>
          <% end %>
        </div>

        <% cumulards = @soutien.cumulards %>
        <% if cumulards.any? %>
          <h3 class="roadmap__sous-titre mt-5">Ceux qui se signalent sur trois matières ou plus</h3>
          <p class="matieres__regle">
            <%= cumulards.size %> étudiant<%= "s" if cumulards.size > 1 %>.
            La difficulté y est rarement ponctuelle : ce sont eux à regarder en premier.
          </p>
          <div class="enrobage-table">
            <table class="recap__table">
              <thead>
                <tr><th>Étudiant</th><th class="recap__nombre">Matières</th><th>Lesquelles</th></tr>
              </thead>
              <tbody>
                <% cumulards.each do |user, ues| %>
                  <tr>
                    <td>
                      <%= user.last_name.to_s.upcase %> <%= user.first_name %>
                      <span class="soutien__num"><%= user.student_number %></span>
                    </td>
                    <td class="recap__nombre"><strong><%= ues.size %></strong></td>
                    <td class="recap__matieres"><%= ues.map { |u| u.code.presence || u.name }.join(" · ") %></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% end %>

        <p class="mt-5">
          <%= link_to "Voir le détail nominatif par matière →", teacher_soutien_path(batch_id: @batch.id),
                      class: "text-decoration-none" %>
        </p>

      <% end %>

    </div>
  </div>
</div>
