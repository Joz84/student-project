

<% if @batch_id.nil? %>
  <div class="container-fluid page-min-height">
    <div class="row">
      <div class="col-md-8 offset-md-2">
        <div class="d-flex justify-content-center align-items-center height-vh my-5">
          <h4>Vous n'êtes affecté à aucun projet pour le moment</h4>
        </div>      
      </div>
    </div>
  </div>
<% else %>
  <div class="container-fluid page-min-height">
    <div class="row">
      <div class="col-md-8 offset-md-2">
        <div class="d-flex justify-content-center my-5">
          <% @batches.each do |batch| %>
            <%= link_to batch.title, teacher_batch_teams_path(batch), class: "btn text-white mx-2 btn-danger #{batch == @batch ? 'border-selected' : ''}" %>
          <% end %>
        </div>

        <h2 class="text-center my-5">Les équipes</h2>

        <div class="card card-body mb-3">
          <a data-bs-toggle="collapse" href="#collapseRepartition" role="button" aria-expanded="false" aria-controls="collapseRepartition">
            Répartition des élèves
          </a>
          <div class="collapse mt-3 <%= "show" if @import || flash.now[:alert] %>" id="collapseRepartition">
            <div class="container">

              <p class="mb-1"><strong>1. Exporter</strong> — enregistrez le fichier dans le dossier <code>repartition_algorithme/</code>, à côté de <code>repartition.py</code>.</p>
              <p class="text-grey"><small>Contient les vœux, les spécialités et le nombre d'équipes possible par projet. <%= @batch.users.kept.where(teacher: nil).booked.count %> classements validés sur <%= @batch.users.kept.where(teacher: nil).count %>.</small></p>
              <%= link_to "Exporter payload-#{@batch.title.parameterize}.json",
                          solver_payload_teacher_batch_teams_path(@batch),
                          class: "btn btn-primary text-white mb-4" %>

              <p class="mb-1"><strong>2. Importer</strong> — déposez ici le résultat produit par le solveur.</p>
              <p class="text-grey"><small>« Simuler » vérifie le fichier sans rien créer. « Importer » crée les équipes : les élèves quittent l'attente et retrouvent leur tableau de bord.</small></p>

              <%= form_with url: import_teacher_batch_teams_path(@batch), method: :post,
                            multipart: true, data: { turbo: false } do %>
                <div class="mb-3">
                  <%= file_field_tag :assignment, accept: "application/json,.json", class: "form-control" %>
                </div>
                <%= submit_tag "Simuler", name: "commit", class: "btn btn-primary text-white me-2" %>
                <%= submit_tag "Importer", name: "commit", class: "btn btn-danger text-white",
                      onclick: "return confirm('Créer les équipes pour de bon ? Les élèves seront affectés à leur projet.')" %>
              <% end %>

              <% if @import %>
                <div class="card card-body mt-4 p-0">
                  <pre class="m-0 p-3" style="overflow-x: auto; white-space: pre; font-size: .85rem;"><%= @import.report %></pre>
                </div>
              <% end %>

            </div>
          </div>
        </div>

        <div class="card card-body">
          <a class="" data-bs-toggle="collapse" href="#collapseTeamCreate" role="button" aria-expanded="false" aria-controls="collapseTeamCreate">
            Constitution des équipes
          </a>
          <div class="collapse mt-3" id="collapseTeamCreate">
            <div class="container">
              <div class="row">
                <div class="col-md-4">
                  <div class="card bg-primary p-3 text-center mb-5">
                    <h6>Nombre d'équipes créées</h6>
                    <h5><%= @teams.count %></h5>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="card bg-primary p-3 text-center mb-5">
                    <h6>Nombre d'élèves en équipe</h6>
                    <h5><%= User.where.not(team: nil).where(teacher: nil, batch: @batch).kept.count %></h5>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="card bg-primary p-3 text-center mb-5">
                    <h6>Nombre d'élèves sans équipe</h6>
                    <h5><%= User.where(teacher: nil, team: nil, batch: @batch).kept.count %></h5>
                  </div>
                </div>
              </div>
              <div class="row">
                <h6>Elèves sans équipe</h6>
                <ul>
                  <% User.where(teacher: nil, team: nil, batch: @batch).kept.each do |user| %>
                    <li><%= user.first_name.capitalize %> <%= user.last_name.capitalize %> - <%= user.email %></li>
                  <% end %>
                </ul>
              </div>
              <div class="row">
                <%# @teams.each do |team| %>
                <% [].each do |team| %>
                  <div class="col-md-4">
                    <div class="card w-100 p-3 mb-2">
                      <h6 class="text-center"><%= team.name %></h6>
                      <small class="text-grey text-center mb-2"><i>Nbr d'élèves : <%= team.users.kept.count %></i></small>
                      <% project = team.project || team.project_ratings.select{ |p, r| r == team.project_ratings.values.max }.keys.first %>                    
                      <div class="rounded py-1 px-3 d-flex align-items-baseline" style="background: <%= project.color %>;">
                        <div class="color-progress me-1" style="background: <%= team.project.present? ? "black" : "white" %>"></div>
                        <div>
                          <%= team.project_ratings[project]&.round(2) %> - <%= project.name %>
                        </div>
                      </div>
                      <div class="card card-body">
                        <a class="" data-bs-toggle="collapse" href="#collapseTeamUpdate<%= team.id %>" role="button" aria-expanded="false" aria-controls="collapseTeamUpdate<%= team.id %>">
                          Attribuer un projet
                        </a>
                        <div class="collapse mt-3" id="collapseTeamUpdate<%= team.id %>">
                          <%= simple_form_for [:teacher, team] do |f| %>
                            <%= f.input :project_id, collection: @batch.projects.map{|p| [p.name, p.id]}.append(["Aucun", nil]), label: false, include_blank: false %>
                            <%= f.submit 'Valider', class: "btn btn-primary w-100" %>
                          <% end %>
                        </div>
                      </div>

                      
                      <div class="card card-body">
                        <a class="" data-bs-toggle="collapse" href="#collapseTeamMembers<%= team.id %>" role="button" aria-expanded="true" aria-controls="collapseTeamMembers<%= team.id %>">
                          Membres de l'équipe
                        </a>
                        <div class="collapse mt-3 show" id="collapseTeamMembers<%= team.id %>">
                          <ul>
                            <% team.users.kept.each do |user| %>
                              <li><%= user.first_name %> <%= user.last_name %></li>
                            <% end %>
                          </ul>
                        </div>
                      </div>
                      <div class="card card-body">
                        <a class="" data-bs-toggle="collapse" href="#collapseProjectRatings<%= team.id %>" role="button" aria-expanded="true" aria-controls="collapseProjectRatings<%= team.id %>">
                          Les notes projets
                        </a>
                        <div class="collapse mt-3 show" id="collapseProjectRatings<%= team.id %>">
                          <% team.project_ratings.each do |project, rating| %>
                              <div><%= rating.round(2) %> - <%= project.name %></div>
                              <div class="card" style="background: <%= project.color %>; width:<%= rating %>%; height: 10px" ></div>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
        
        <% @teachers.each do |teacher| %>
          <h4 class="mt-5">Professeur <%= teacher.last_name.capitalize %></h4>
          
          <% teacher.supervised_projects.where(batch: @batch).each do |project| %>
            <% if project.kept_teams.any? %>
              <h6><%= project.name %></h6>
              <div class="container-fluid">
                <div class="row">
                  <% project.kept_teams.each do |team| %>
                    <div class="col-md-4">
                      <div class="card w-100 p-3 mb-2">
                        <h6 class="text-center"><%= team.name %></h6>
                        <small class="text-grey text-center"><i><%= team.project.name.capitalize %></i></small>
                        <ul>
                          
                          <% team.users.kept.each do |user| %>
                            <li><%= user.first_name %> <%= user.last_name %></li>
                          <% end %>
                          
                        </ul>
                        <%= link_to "lien", team, target: "_blank" %>
                      </div>   
                    </div>         
                  <% end %>
                </div>
              </div>
            <% end %>
            
          <% end %>
          
        <% end %>

      </div>
    </div>
  </div>

<% end %>