

<% if @batch_id.nil? %>
  <div class="container-fluid page-min-height">
    <div class="row">
      <div class="col-md-8 offset-md-2">
        <div class="d-flex justify-content-center align-items-center height-vh my-5">
          <h4>Vous n'êtes affecté à aucun projet pour le moment</h4>
        </div>      
      </div>
    </div>
  </div>
<% else %>
  <div class="container-fluid page-min-height">
    <div class="row">
      <div class="col-md-8 offset-md-2">
        <div class="d-flex justify-content-center my-5">
          <% @batches.each do |batch| %>
            <%= link_to batch.title, teacher_batch_teams_path(batch), class: "btn text-white mx-2 btn-danger #{batch == @batch ? 'border-selected' : ''}" %>
          <% end %>
        </div>

        <h2 class="text-center my-5">Les équipes</h2>

        <%= render "project_scores" if @project_demand.present? %>
        <%= render "repartition" if @repartition_rows.present? %>

        <%# Le bloc « Répartition des étudiants » — export du payload et import du
            solveur — a été retiré de l'affichage : la répartition est faite, et
            il n'avait plus lieu d'être proposé à chaque visite. Les routes
            existent toujours, il suffit de rétablir ce bloc pour le rouvrir. %>

        <div class="card card-body">
          <a class="" data-bs-toggle="collapse" href="#collapseTeamCreate" role="button" aria-expanded="false" aria-controls="collapseTeamCreate">
            Avancement des équipes
          </a>
          <div class="collapse mt-3" id="collapseTeamCreate">
            <div class="container">
              <div class="row">
                <div class="col-md-4">
                  <div class="card bg-primary p-3 text-center mb-5">
                    <h6>Nombre d'équipes créées</h6>
                    <h5><%= @teams.count %></h5>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="card bg-primary p-3 text-center mb-5">
                    <h6>Nombre d'étudiants en équipe</h6>
                    <h5><%= @en_equipe %></h5>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="card bg-primary p-3 text-center mb-5">
                    <h6>Nombre d'étudiants sans équipe</h6>
                    <h5><%= @sans_equipe.size %></h5>
                  </div>
                </div>
              </div>
              <%# Chaque liste se déplie à la demande : quatre listes de vingt noms
                  déroulées d'office, on ne trouve plus celle qu'on cherche. %>
              <div class="row">
                <% [["sans-equipe", "Étudiants sans équipe", @sans_equipe, "#E3E8EF",
                     "Ni projet ni équipe : ils n'ont pas de tableau de bord."],
                    ["non-modifies", "Étudiants n'ayant pas modifié leurs choix", @non_modifies, "#FFE0E0",
                     "Leur classement est resté dans l'ordre proposé par défaut."],
                    ["modifies", "Étudiants ayant modifié leurs choix", @modifies, "#FFF4C1",
                     "Ils ont réordonné leurs vœux mais ne les ont pas encore validés."],
                    ["valides", "Étudiants ayant validé leurs choix", @valides, "#C7F0D8",
                     "Classement validé, il n'est plus modifiable."]].each do |cle, titre, liste, teinte, aide| %>
                  <div class="liste-pliante">
                    <a class="liste-pliante__tete" data-bs-toggle="collapse"
                       href="#liste<%= cle %>" role="button" aria-expanded="false"
                       aria-controls="liste<%= cle %>">
                      <span class="liste-pliante__puce" style="background: <%= teinte %>;"></span>
                      <span class="liste-pliante__titre"><%= titre %></span>
                      <span class="liste-pliante__compte"><%= liste.size %></span>
                    </a>
                    <div class="collapse" id="liste<%= cle %>">
                      <div class="liste-pliante__corps">
                        <p class="text-grey mb-2"><small><%= aide %></small></p>
                        <% if liste.any? %>
                          <ul class="mb-0">
                            <% liste.each do |user| %>
                              <li>
                                <%= user.first_name.capitalize %> <%= user.last_name.capitalize %>
                                <% if user.td.present? %><span class="chip-sujet bg-maths"><%= user.td %></span><% end %>
                                <% if user.tp.present? %><span class="chip-sujet bg-chimie"><%= user.tp %></span><% end %>
                                <span class="text-grey">— <%= user.email %>
                                  <% if user.speciality %>· <%= user.speciality.name %><% else %>· <em>sans spécialité</em><% end %>
                                </span>
                              </li>
                            <% end %>
                          </ul>
                        <% else %>
                          <p class="text-grey mb-0"><small><em>Aucun</em></small></p>
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
              <div class="row">
                <%# @teams.each do |team| %>
                <% [].each do |team| %>
                  <div class="col-md-4">
                    <div class="card w-100 p-3 mb-2">
                      <h6 class="text-center"><%= team.name %></h6>
                      <small class="text-grey text-center mb-2"><i>Nbr d'étudiants : <%= team.users.kept.count %></i></small>
                      <% project = team.project || team.project_ratings.select{ |p, r| r == team.project_ratings.values.max }.keys.first %>                    
                      <div class="rounded py-1 px-3 d-flex align-items-baseline" style="background: <%= project.color %>;">
                        <div class="color-progress me-1" style="background: <%= team.project.present? ? "black" : "white" %>"></div>
                        <div>
                          <%= team.project_ratings[project]&.round(2) %> - <%= project.name %>
                        </div>
                      </div>
                      <div class="card card-body">
                        <a class="" data-bs-toggle="collapse" href="#collapseTeamUpdate<%= team.id %>" role="button" aria-expanded="false" aria-controls="collapseTeamUpdate<%= team.id %>">
                          Attribuer un projet
                        </a>
                        <div class="collapse mt-3" id="collapseTeamUpdate<%= team.id %>">
                          <%= simple_form_for [:teacher, team] do |f| %>
                            <%= f.input :project_id, collection: @batch.projects.map{|p| [p.name, p.id]}.append(["Aucun", nil]), label: false, include_blank: false %>
                            <%= f.submit 'Valider', class: "btn btn-primary w-100" %>
                          <% end %>
                        </div>
                      </div>

                      
                      <div class="card card-body">
                        <a class="" data-bs-toggle="collapse" href="#collapseTeamMembers<%= team.id %>" role="button" aria-expanded="true" aria-controls="collapseTeamMembers<%= team.id %>">
                          Membres de l'équipe
                        </a>
                        <div class="collapse mt-3 show" id="collapseTeamMembers<%= team.id %>">
                          <ul>
                            <% team.users.kept.each do |user| %>
                              <li><%= user.first_name %> <%= user.last_name %></li>
                            <% end %>
                          </ul>
                        </div>
                      </div>
                      <div class="card card-body">
                        <a class="" data-bs-toggle="collapse" href="#collapseProjectRatings<%= team.id %>" role="button" aria-expanded="true" aria-controls="collapseProjectRatings<%= team.id %>">
                          Les notes projets
                        </a>
                        <div class="collapse mt-3 show" id="collapseProjectRatings<%= team.id %>">
                          <% team.project_ratings.each do |project, rating| %>
                              <div><%= rating.round(2) %> - <%= project.name %></div>
                              <div class="card" style="background: <%= project.color %>; width:<%= rating %>%; height: 10px" ></div>
                          <% end %>
                        </div>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
        
        <% if @equipes_sans_projet.present? %>
          <div class="teacher-block">
            <div class="teacher-block__head">
              <h4>Équipes sans projet</h4>
              <span class="teacher-block__count">
                <%= @equipes_sans_projet.size %> équipe<%= "s" if @equipes_sans_projet.size > 1 %> ·
                aucun référent ne peut leur être associé
              </span>
            </div>
            <ul class="orphan-list">
              <% @equipes_sans_projet.sort_by { |t| t.name.to_s }.each do |t| %>
                <li>
                  <%= link_to t.name, t %>
                  <span class="team-card__muted">
                    <%= t.membres.size %> étudiant<%= "s" if t.membres.size > 1 %> —
                    <%= t.membres.map { |u| "#{u.first_name} #{u.last_name}" }.join(", ") %>
                  </span>
                </li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <% @teachers.each do |teacher| %>
          <% equipes = @equipes_par_enseignant[teacher.id] || [] %>
          <% next if equipes.empty? %>
          <div class="teacher-block">
            <div class="teacher-block__head">
              <h4><%= teacher.first_name %> <%= teacher.last_name.capitalize %></h4>
              <span class="teacher-block__count">
                <%= equipes.size %> équipe<%= "s" if equipes.size > 1 %> ·
                <%= equipes.sum { |t| t.membres.size } %> étudiants ·
                <%= equipes.map(&:project_id).uniq.size %> projet<%= "s" if equipes.map(&:project_id).uniq.size > 1 %>
              </span>
            </div>
            <div class="team-grid">
              <% equipes.each do |team| %>
                <%= render "teacher/teams/team_card", team: team %>
              <% end %>
            </div>
          </div>
        <% end %>

      </div>
    </div>
  </div>

<% end %>