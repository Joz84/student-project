<% return if team.project.nil? %>
<% membres = team.membres %>
<% td = membres.map(&:td).compact.uniq %>
<% tp = membres.map(&:tp).compact.uniq %>
<% valides = team.actuels.count(&:booked?) %>

<div class="col">
  <div class="team-card h-100">
    <div class="team-card__bar bg-<%= team.project.subject %>"></div>

    <div class="team-card__body">
      <div class="team-card__top">
        <span class="chip-sujet bg-<%= team.project.subject %>"><%= team.project.subject_label %></span>
        <span class="team-card__tags">
          <% td.each do |v| %><span class="team-tag"><%= v %></span><% end %>
          <% tp.each do |v| %><span class="team-tag"><%= v %></span><% end %>
        </span>
      </div>

      <h6 class="team-card__title" title="<%= team.project.name %>"><%= team.project.name %></h6>
      <p class="team-card__team">Équipe <%= team.name %></p>

      <div class="team-card__people">
        <div class="avatar-stack">
          <% membres.each do |user| %>
            <span class="avatar-sm <%= "avatar-sm--parti" if team.parti?(user) %>"
                  style="background: <%= user.avatar_color %>;"
                  title="<%= user.first_name %> <%= user.last_name %><%= " — a quitté l'équipe" if team.parti?(user) %>">
              <%= "#{user.first_name.to_s.first}#{user.last_name.to_s.first}".upcase %>
            </span>
          <% end %>
        </div>
        <span class="team-card__count">
          <%= team.actuels.size %> étudiant<%= "s" if team.actuels.size > 1 %>
          <% if team.passes.any? %>
            <span class="team-card__muted">· <%= team.passes.size %> parti<%= "s" if team.passes.size > 1 %></span>
          <% end %>
          <% if valides < team.actuels.size %>
            <span class="team-card__muted">· <%= valides %> ayant classé</span>
          <% end %>
        </span>
      </div>

      <ul class="team-card__list">
        <% membres.each do |user| %>
          <li class="<%= "team-card__parti" if team.parti?(user) %>">
            <%= user.first_name %> <%= user.last_name %>
            <% if team.parti?(user) %>
              <span class="team-card__muted">parti</span>
            <% elsif !user.booked? %>
              <span class="team-card__muted">sans classement</span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>

    <%= link_to team, class: "team-card__link" do %>
      Ouvrir le tableau de bord
      <span aria-hidden="true">→</span>
    <% end %>
  </div>
</div>
