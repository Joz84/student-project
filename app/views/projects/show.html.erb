<div class="container page-min-height">
  <div class="row">
    <div class="col-md-8 offset-md-2">

      <div class="my-4">
        <%= link_to "← Retour aux projets", projects_path, class: "text-decoration-none", style: "color: #5B6874;" %>
      </div>

      <article class="card card-body p-4 p-md-5 mb-5">
        <div class="text-center mb-3">
          <span class="chip bg-<%= @project.subject %>"><%= @project.subject_label %></span>
        </div>

        <h2 class="text-center mb-3"><%= @project.name %></h2>

        <p class="text-center mb-4" style="font-size: .88rem; color: #8A96A3;">
          <% if @project.author.present? %>
            Référent <strong style="color: #5B6874;"><%= @project.author %></strong>
          <% end %>
          <% if @project.partner.present? && @project.partner != @project.author %>
            · Partenaire <strong style="color: #5B6874;"><%= @project.partner %></strong>
          <% end %>
        </p>

        <hr style="border-color: #EEF1F4; margin: 0 0 1.8rem;">

        <div class="text-justify" style="line-height: 1.7; color: #38424D;">
          <%= simple_format @project.description %>
        </div>

        <% if @project.drive_link.present? %>
          <div class="mt-4">
            <%= link_to "Fiche complète du projet", @project.drive_link, target: "_blank",
                        class: "btn btn-outline-ink px-4 py-2" %>
          </div>
        <% end %>
      </article>

    </div>
  </div>
</div>
