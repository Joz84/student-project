<div class="container page-min-height">
  <div class="row">
    <div class="col-md-6 col-lg-5 offset-md-3 offset-lg-4">
      <h2 class="text-center my-5">Mot de passe oublié ?</h2>

      <div class="auth-card">
        <p class="text-center mb-4" style="font-size: .88rem; color: #5B6874;">
          Saisis l'adresse de ton compte : tu recevras un lien pour choisir
          un nouveau mot de passe. Pense à regarder dans tes spams.
        </p>

        <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name),
                            html: { method: :post }, data: { turbo: false }) do |f| %>
          <%= f.error_notification %>

          <div class="form-inputs">
            <%= f.input :email,
                        label: "Adresse e-mail",
                        required: true,
                        autofocus: true,
                        input_html: { autocomplete: "email" } %>
          </div>

          <div class="form-actions">
            <%= f.button :submit, "Recevoir le lien", class: "btn btn-danger text-white w-100 py-3 mt-2" %>
          </div>
        <% end %>

        <div class="auth-links text-center">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>
  </div>
</div>
