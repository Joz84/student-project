<div class="container page-min-height">
  <div class="row">
    <div class="col-md-6 offset-md-3">
      <h2 class="text-center my-5">Choisir un nouveau mot de passe</h2>

      <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name),
                          html: { method: :put }, data: { turbo: false }) do |f| %>
        <%= f.error_notification %>

        <%= f.input :reset_password_token, as: :hidden %>
        <%= f.full_error :reset_password_token %>

        <div class="form-inputs">
          <%= f.input :password,
                      label: "Nouveau mot de passe",
                      required: true,
                      autofocus: true,
                      hint: ("#{@minimum_password_length} caractères minimum" if @minimum_password_length),
                      input_html: { autocomplete: "new-password" } %>
          <%= f.input :password_confirmation,
                      label: "Confirmer le nouveau mot de passe",
                      required: true,
                      input_html: { autocomplete: "new-password" } %>
        </div>

        <div class="form-actions">
          <%= f.button :submit, "Enregistrer et me connecter", class: "btn btn-danger text-white w-100 py-3 mb-3" %>
        </div>
      <% end %>

      <div class="text-center">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
