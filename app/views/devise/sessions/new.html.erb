<div class="container page-min-height">
  <div class="row">
    <div class="col-md-6 col-lg-5 offset-md-3 offset-lg-4">
      <h2 class="text-center my-5">Se connecter</h2>

      <div class="auth-card">
        <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name), data: { turbo: false }) do |f| %>
          <div class="form-inputs">
            <%= f.input :email,
                        label: "Adresse e-mail",
                        required: false,
                        autofocus: true,
                        input_html: { autocomplete: "email" } %>
            <%= f.input :password,
                        label: "Mot de passe",
                        required: false,
                        input_html: { autocomplete: "current-password" } %>
            <%= f.input :remember_me, label: "Se souvenir de moi", as: :boolean if devise_mapping.rememberable? %>
          </div>

          <div class="form-actions">
            <%= f.button :submit, "Se connecter", class: "btn btn-danger text-white w-100 py-3 mt-2" %>
          </div>
        <% end %>

        <div class="auth-links text-center">
          <%= render "devise/shared/links" %>
        </div>
      </div>
    </div>
  </div>
</div>
