<div class="band page-min-height">
  <div class="container band__inner">
    <div class="row">
      <div class="col-md-8 col-lg-6 offset-md-2 offset-lg-3">
        <h2 class="text-center my-5">Mon compte</h2>

        <div class="auth-card">
          <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name),
                              html: { method: :put }, data: { turbo: false }) do |f| %>
            <%= f.error_notification %>

            <div class="form-inputs">
              <%= f.input :email, label: "Adresse e-mail", required: true, autofocus: true %>
              <%= f.input :first_name, label: "Prénom", required: true %>
              <%= f.input :last_name, label: "Nom", required: true %>
              <%= f.input :student_number, label: "Numéro étudiant", required: true %>
              <%= f.input :batch_id, label: "Promotion",
                          collection: Batch.all.map { |b| [b.title, b.id] }, required: true %>

              <hr style="border-color: #EEF1F4; margin: 1.5rem 0;">

              <%= f.input :password,
                          label: "Nouveau mot de passe",
                          hint: "Laisse vide pour conserver le mot de passe actuel.",
                          required: false,
                          input_html: { autocomplete: "new-password" } %>
              <%= f.input :password_confirmation,
                          label: "Confirmer le nouveau mot de passe",
                          required: false,
                          input_html: { autocomplete: "new-password" } %>
              <%= f.input :current_password,
                          label: "Mot de passe actuel",
                          hint: "Nécessaire pour valider les modifications.",
                          required: true,
                          input_html: { autocomplete: "current-password" } %>
            </div>

            <div class="form-actions">
              <%= f.button :submit, "Enregistrer", class: "btn btn-danger w-100 py-3 mt-2" %>
            </div>
          <% end %>

          <div class="auth-links text-center">
            <%= link_to "Retour", :back %>
          </div>
        </div>

        <div class="text-center my-4">
          <%= button_to "Supprimer mon compte", registration_path(resource_name),
                        method: :delete,
                        class: "btn btn-outline-ink",
                        data: { turbo_confirm: "Cette action est définitive : ton compte, ton classement et ton appartenance à une équipe seront supprimés. Confirmer ?" } %>
        </div>
      </div>
    </div>
  </div>
</div>
