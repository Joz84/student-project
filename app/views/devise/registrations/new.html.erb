<div class="band page-min-height">
  <div class="container band__inner">
  <div class="row">
    <div class="col-md-8 col-lg-6 offset-md-2 offset-lg-3">
      <h2 class="text-center my-5">S'inscrire</h2>

      <div class="auth-card">
      <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), data: { turbo: false }) do |f| %>
        <%= f.error_notification %>

        <div class="form-inputs">
          <%= f.input :email,
                      label: "Adresse e-mail",
                      required: true,
                      autofocus: true,
                      input_html: { autocomplete: "email" }%>
          <%= f.input :password,
                      label: "Mot de passe",
                      required: true,
                      hint: ("#{@minimum_password_length} caractères minimum" if @minimum_password_length),
                      input_html: { autocomplete: "new-password" } %>
          <%= f.input :password_confirmation,
                      label: "Confirmation du mot de passe",
                      required: true,
                      input_html: { autocomplete: "new-password" } %>
          <%= f.input :first_name,
                      label: "Prénom",
                      required: true %>
          <%= f.input :last_name,
                      label: "Nom" ,
                      required: true %>
          <%= f.input :student_number,
                      label: "Numéro étudiant" ,
                      required: true %>
          <%= f.input :batch_id, label: "Promotion",
                      collection: Batch.all.map { |b| [b.title, b.id] },
                      required: true %>
        </div>

        <div class="form-actions">
          <%= f.button :submit, "S'inscrire", class: "btn btn-danger text-white w-100 py-3 mb-3" %>
        </div>
      <% end %>

      <div class="auth-links text-center">
        <%= render "devise/shared/links" %>
      </div>
      </div>
    </div>
  </div>
</div>
</div>
