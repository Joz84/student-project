<%#
  Marque UPF-Project : la pirogue à voile d'origine, redessinée en tracés
  géométriques. `variant` vaut :color sur fond clair, :light sur fond sombre
  (barre de navigation, pied de page). Le tracé est centré dans sa boîte.
%>
<% variant ||= :color %>
<% coque  = variant == :light ? "#FFFFFF" : "#16202A" %>
<% voile1 = variant == :light ? "#FFFFFF" : "#2C6EB8" %>
<% voile2 = "#89BF48" %>
<svg viewBox="0 0 64 64" width="<%= size ||= 40 %>" height="<%= size %>"
     role="img" aria-label="UPF-Project" focusable="false" style="display: block; flex: 0 0 auto;">
  <g transform="translate(0, 3)">
    <path d="M33 48 L33 21 C33 13 36.8 7.6 44.5 5 C40.6 11.6 39.6 15.6 39.6 21 L39.6 48 Z" fill="<%= voile1 %>"/>
    <path d="M21 48 L21 25.5 C21 18 24.5 13.2 31.5 10.6 C27.8 16.8 26.9 20.6 26.9 25.5 L26.9 48 Z" fill="<%= voile2 %>"/>
    <path d="M3.2 31.5 C4.2 38.4 5.2 43 6.9 46.9 C18 55.8 46 56.2 60.5 45.4 C47 52.2 17 51.6 7.4 46.2 C5.8 42.2 4.8 37 4.4 31.6 Z" fill="<%= coque %>"/>
  </g>
</svg>
