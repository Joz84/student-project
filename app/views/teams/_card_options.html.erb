<% carte_visee = params[:carte].to_s == card.id.to_s %>
<% volet = carte_visee ? params[:volet] : nil %>
<a class="btn btn-primary text-white" data-bs-toggle="collapse" href="#collapse<%= card.id %>" role="button" aria-expanded="<%= carte_visee %>" aria-controls="collapse<%= card.id %>">
Options
</a>
<div class="collapse <%= "show" if carte_visee %>" id="collapse<%= card.id %>">
  <div class="">
    <div class="accordion" id="accordion<%= card.id %>">
        <div class="accordion-item">
          <h2 class="accordion-header">
              <button class="accordion-button accordion-padding collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseZero<%= card.id%>" aria-expanded="false" aria-controls="collapseZero<%= card.id%>">
              Description
              </button>
          </h2>
          <div id="collapseZero<%= card.id%>" class="accordion-collapse collapse" data-bs-parent="#accordion<%= card.id %>">
              <div class="accordion-body">
                <p><%= card.description %></p>            
              </div>
          </div>
        </div>

        
        <% if card.pending? %>
          
        <div class="accordion-item">
          <h2 class="accordion-header">
              <button class="accordion-button accordion-padding collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne<%= card.id%>" aria-expanded="false" aria-controls="collapseOne<%= card.id%>">
              Compétences visées
              </button>
          </h2>
          <div id="collapseOne<%= card.id%>" class="accordion-collapse collapse <%= "show" if volet == "competences" %>" data-bs-parent="#accordion<%= card.id %>">
            <div class="accordion-body">
              <div class="puces-choisies">
                <% card.card_skills.each do |card_skill| %>
                  <%= link_to card_skill_path(card_skill), data: { "turbo-method": :delete, "turbo_confirm": "Retirer cette compétence ?" }, class: "puce-choisie" do %>
                    <%= "#{card_skill.skill.skill_block.position}.#{card_skill.skill.position}" %> <span aria-hidden="true">×</span>
                  <% end %>
                <% end %>
                <% if card.card_skills.empty? %><span class="text-grey"><small>Aucune compétence visée.</small></span><% end %>
              </div>
              <hr>
              <%= form_with url: card_card_skills_path(card), method: :post, data: { turbo: false } do %>
                <p class="choix__titre">Ajouter des compétences</p>
                <div class="choix choix--long">
                  <% deja = card.card_skills.map(&:skill_id) %>
                  <% @all_skills.each do |skill| %>
                    <label class="choix__ligne <%= "choix__ligne--prise" if deja.include?(skill.id) %>">
                      <%= check_box_tag "card_skill[skill_ids][]", skill.id, false,
                            id: "sk-#{card.id}-#{skill.id}", disabled: deja.include?(skill.id) %>
                      <span><%= skill.skill_block.position %>.<%= skill.position %> — <%= skill.title %></span>
                    </label>
                  <% end %>
                </div>
                <%= submit_tag "Ajouter la sélection", class: "btn btn-danger w-100 mt-2" %>
              <% end %>
            </div>
          </div>
        </div>

        <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button accordion-padding collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo<%= card.id%>" aria-expanded="false" aria-controls="collapseTwo<%= card.id%>">
            Gestion des collaborateur
            </button>
        </h2>        

        <div id="collapseTwo<%= card.id%>" class="accordion-collapse collapse <%= "show" if volet == "collaborateurs" %>" data-bs-parent="#accordion<%= card.id %>">
            <div class="accordion-body">
              <% card.assignments.each do |assignment| %>
                <%= link_to assignment_path(assignment), data: { "turbo-method": :delete, "turbo_confirm": "Retirer ce collaborateur ?" }, class: "w-100 d-flex justify-content-between px-3 text-black" do %>
                  <div><%= "#{assignment.user.first_name.capitalize} #{assignment.user.last_name.first.upcase}." %></div>
                  <i class="fa-regular fa-trash-can"></i>
                <% end %>
              <% end %>
              <% if card.assignments.empty? %><span class="text-grey"><small>Personne n'est encore affecté.</small></span><% end %>
              <hr>
              <% restants = card.list.team.users.kept.where.not(id: card.users.kept.map(&:id)) %>
              <% if restants.any? %>
                <%= form_with url: card_assignments_path(card), method: :post, data: { turbo: false } do %>
                  <p class="choix__titre">Ajouter des collaborateurs</p>
                  <div class="choix">
                    <% restants.each do |membre| %>
                      <label class="choix__ligne">
                        <%= check_box_tag "assignment[user_ids][]", membre.id, false, id: "co-#{card.id}-#{membre.id}" %>
                        <span><%= membre.first_name %> <%= membre.last_name %></span>
                      </label>
                    <% end %>
                  </div>
                  <%= submit_tag "Ajouter la sélection", class: "btn btn-danger w-100 mt-2" %>
                <% end %>
              <% else %>
                <p class="text-grey mb-0"><small>Toute l'équipe est déjà sur cette tâche.</small></p>
              <% end %>
            </div>
        </div>
        </div>

        <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button accordion-padding collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree<%= card.id%>" aria-expanded="false" aria-controls="collapseThree<%= card.id%>">
            Modifier la tâche
            </button>
        </h2>
        <div id="collapseThree<%= card.id%>" class="accordion-collapse collapse p-2" data-bs-parent="#accordion<%= card.id %>">
            <%= simple_form_for card do |f| %>
            <%= f.input :name %>
            <%= f.input :description %>
            <%= f.input :drive_link %>
            <div class="d-flex justify-content-between">
              <%= f.input :time_estimate %>
              <%= f.input :time_unit, collection: ["jour(s)", "semaine(s)", "mois"]  %>               
            </div>
            <%= f.button :submit, "Valider", class: "btn btn-danger text-white w-100" %>
            <% end %>
        </div>
        </div>

        <% else %>

          <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button accordion-padding collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne<%= card.id%>" aria-expanded="false" aria-controls="collapseOne<%= card.id%>">
                Compétences visées
                </button>
            </h2>
            <div id="collapseOne<%= card.id%>" class="accordion-collapse collapse" data-bs-parent="#accordion<%= card.id %>">
              <div class="accordion-body">
                <div class="d-flex justifify-content-start">
                  <% card.card_skills.each do |card_skill| %>
                    <div class="btn btn-primary text-white text-decoration-none border"><%= "#{card_skill.skill.skill_block.position}.#{card_skill.skill.position}" %></div>
                  <% end %>
                </div>            
              </div>
            </div>
          </div>

        <% end %>

        <% if card.team&.milestones&.any? %>
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button class="accordion-button accordion-padding collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseJalon<%= card.id %>" aria-expanded="false" aria-controls="collapseJalon<%= card.id %>">
                Étape de la feuille de route
              </button>
            </h2>
            <div id="collapseJalon<%= card.id %>" class="accordion-collapse collapse p-2" data-bs-parent="#accordion<%= card.id %>">
              <%= form_with url: card_path(card), method: :patch, data: { turbo: false } do %>
                <%= select_tag "card[milestone_id]",
                      options_from_collection_for_select(card.team.milestones.ordonnes, :id, :name, card.milestone_id),
                      include_blank: "Aucune étape", class: "form-select form-select-sm mb-2",
                      onchange: "this.form.requestSubmit()" %>
              <% end %>
            </div>
          </div>
        <% end %>

        <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button accordion-padding collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFour<%= card.id%>" aria-expanded="false" aria-controls="collapseFour<%= card.id%>">
            Changer le statut de la tâche
            </button>
        </h2>
        <div id="collapseFour<%= card.id%>" class="accordion-collapse collapse p-2" data-bs-parent="#accordion<%= card.id %>">
            
          <% if card.active? %>
            <%= link_to "Archiver la tâche", card_path(card, card: {status: :archived}), data: { "turbo-method": :patch, "turbo_confirm": "Êtes vous sûrs de vouloir archiver cette tâche?" }, class: "btn btn-primary  text-white w-100 mb-1" %>
          <% elsif card.archived? %>
            <%= link_to "Déarchiver la tâche", card_path(card, card: {status: :active}), data: { "turbo-method": :patch, "turbo_confirm": "Êtes vous sûrs de vouloir archiver cette tâche?" }, class: "btn btn-primary  text-white w-100 mb-1" %>
          <% end %>
          
          <% if card.pending? %>
            <%= link_to "Supprimer la tâche", card_path(card), data: { "turbo-method": :delete, "turbo_confirm": "Êtes vous sûrs de vouloir supprimer cette tâche?" }, class: "btn btn-supp w-100" %>
          <% else %>
            <%= link_to "Supprimer la tâche", card_path(card, card: {status: :hidden}), data: { "turbo-method": :patch, "turbo_confirm": "Êtes vous sûrs de vouloir supprimer cette tâche?" }, class: "btn btn-supp w-100" %>
          <% end %>
            
        </div>
        </div>
    </div>
  </div>
</div>

<% if current_user.teacher? %>
  <p class="my-2"><b>Évaluation Enseignant</b></p>
  <div class="d-flex justify-content-between">
    <% Card.teacher_validations.each do |teacher_validation, index| %>
      <% if index > 0 %>         
        <%= link_to index, card_path(card, card: {teacher_validation: teacher_validation}), data: { "turbo-method": :patch, "turbo_confirm": "Êtes vous sûrs de vouloir faire cette action?" }, class: "btn #{teacher_validation} #{'border-selected' if card.teacher_validation == teacher_validation} w-100" %>
      <% end %>
    <% end %>
  </div>
  <div class="d-flex justify-content-between">
    <% if !card.pending? %>         
      <%= link_to "Annuler la validation", card_path(card, card: {teacher_validation: :pending}), data: { "turbo-method": :patch, "turbo_confirm": "Êtes vous sûrs de vouloir faire cette action?" }, class: "btn btn-primary text-white w-100 mt-3" %>
    <% end %>
  </div>
<% end %>

